# Core
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=require
SECRET_KEY=change-this-in-production
DEBUG=false
AUTH_BYPASS_ENABLED=false
# Dev-only: when true (and DEBUG=true), PPP endpoints bypass official/admin role checks
PPP_DEV_ALLOW_NON_OFFICIAL=false
HYDROMETEO_PROVIDER_ENABLED=true
HYDROMETEO_TIMEOUT_SECONDS=8.0
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Comma-separated origins allowed by CORS
# Local + deployed frontend example:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional integrations
GROQ_API_KEY=
MAPBOX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Optional emergency contacts (comma-separated)
EMERGENCY_CONTACTS=

# Optional local path if you mount raw LiDAR data
LIDAR_DATA_PATH=../data/raw
